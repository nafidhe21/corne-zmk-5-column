#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define SYM     1
#define NAV     2
#define NUM     3
#define FUNC    4
#define SETTINGS 5

&caps_word { continue-list = <UNDERSCORE MINUS>; };

&soft_off {
    hold-time-ms = <5000>; // Only turn off if the key is held for 5 seconds or longer.
};

&soft_off { /delete-property/ split-peripheral-off-on-press; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
            layers = <0>;
            timeout-ms = <50>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        combo_ctrl_backspace {
            bindings = <&kp RC(BACKSPACE)>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <32 33>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_ctrl_shift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <25 26>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <15 16>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_alt_shift {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <15 16>;
            timeout-ms = <50>;
            layers = <3>;
        };
    };
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hs: homerow_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "POSITIONAL_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <2>;    // <---[[the W key]]
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Default";
            bindings = <
&none  &kp Q  &kp W  &kp E      &kp R         &kp T              &kp Y  &kp U      &kp I         &kp O    &kp P          &none
&none  &kp A  &kp S  &kp D      &kp F         &kp G              &kp H  &kp J      &kp K         &kp L    &kp SEMICOLON  &none
&none  &kp Z  &kp X  &kp C      &kp V         &kp B              &kp N  &kp M      &kp COMMA     &kp DOT  &kp FSLH       &none
                     &kp RCTRL  &kp LEFT_ALT  &kp RIGHT_SHIFT    &to 1  &kp SPACE  &kp LEFT_WIN
            >;
        };

        symbol_layer {
            label = "Symbols";
            bindings = <
&none  &kp ESC  &kp AT_SIGN  &kp HASH   &kp DOLLAR  &kp PERCENT        &kp CARET         &kp AMPERSAND         &kp ASTERISK           &kp EXCLAMATION    &kp BACKSPACE  &none
&none  &kp TAB  &kp EQUAL    &kp PLUS   &kp MINUS   &kp UNDERSCORE     &kp LEFT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE    &kp ENTER      &none
&none  &to 4    &kp GRAVE    &kp TILDE  &kp PIPE    &kp BACKSLASH      &kp LEFT_BRACKET  &kp DOUBLE_QUOTES     &kp SINGLE_QUOTE       &kp RIGHT_BRACKET  &to 2          &none
                             &kp RCTRL  &to 0       &kp RIGHT_SHIFT    &kp SPACE         &to 3                 &kp LEFT_ALT
            >;
        };

        nav_layer {
            label = "Navigation";
            bindings = <
&none  &kp ESCAPE  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT  &kp BACKSPACE  &none
&none  &kp TAB     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &kp LEFT        &kp DOWN        &kp UP_ARROW   &kp RIGHT        &kp ENTER      &none
&none  &to 4       &kp LEFT_WIN    &mkp MCLK       &trans           &trans            &trans          &trans          &trans         &trans           &to 2          &none
                                   &kp LCTRL       &to 0            &kp LEFT_SHIFT    &kp SPACE       &to 2           &kp RIGHT_ALT
            >;
        };

        num_layer {
            label = "Numbers";
            bindings = <
&none  &kp ESCAPE   &kp CAPS       &kp SCROLLLOCK  &kp KP_NUMLOCK   &kp PG_UP         &kp HOME      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSPACE  &none
&none  &kp LS(TAB)  &kp LS(K_CUT)  &kp LS(K_COPY)  &kp LS(K_PASTE)  &kp LS(PG_DN)     &kp END       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ENTER      &none
&none  &to 4        &kp INSERT     &kp K_UNDO      &kp K_REDO       &kp DELETE        &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &to 2          &none
                                   &kp RCTRL       &to 0            &kp LEFT_SHIFT    &kp SPACE     &to 1         &kp LEFT_ALT
            >;
        };

        function_layer {
            label = "Function_&_Media";
            bindings = <
&none  &kp ESCAPE  &kp C_BRIGHTNESS_DEC  &trans            &kp C_BRIGHTNESS_INC  &trans            &kp F9     &kp F10  &kp F11        &kp F12  &kp BACKSPACE  &none
&none  &kp TAB     &kp C_PREVIOUS        &kp C_PLAY_PAUSE  &kp C_NEXT            &trans            &kp F5     &kp F6   &kp F7         &kp F8   &kp ENTER      &none
&none  &to 4       &trans                &kp C_MUTE        &trans                &to 5             &kp F1     &kp F2   &kp F3         &kp F4   &to 2          &none
                                         &kp LCTRL         &to 0                 &kp LEFT_SHIFT    &kp SPACE  &to 3    &kp RIGHT_ALT
            >;
        };

        settings_layer {
            label = "settings";
            bindings = <
&none  &kp ESCAPE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR        &trans     &trans       &trans          &trans      &kp BACKSPACE  &none
&none  &kp TAB     &trans        &bt BT_NXT    &bt BT_PRV    &bt BT_CLR_ALL    &trans     &bootloader  &studio_unlock  &sys_reset  &kp ENTER      &none
&none  &to 4       &trans        &out OUT_BLE  &out OUT_USB  &to 5             &trans     &trans       &trans          &trans      &to 2          &none
                                 &kp LCTRL     &to 0         &kp LEFT_SHIFT    &kp SPACE  &to 3        &kp RIGHT_ALT
            >;
        };
    };
};
